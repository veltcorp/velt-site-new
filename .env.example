# GitHub OAuth (Decap CMS)
# NÃO commitar valores reais. Em produção, configure na Vercel:
#   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OAUTH_STATE_SECRET
# O código lê via process.env em server.js — não precisa colar secret no código.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_STATE_SECRET=

# Opcional: forçar URL base do OAuth (senão usa o domínio da requisição)
# SITE_URL=https://www.veltcorp.com.br

# Google Maps (Guia BH — /guiabh)
# Key pública no browser; restrinja por HTTP referrer + APIs (Maps JS + Places New).
# Em produção: Vercel → Environment Variables.
GOOGLE_MAPS_API_KEY=
# Map ID do Map Management (ou DEMO_MAP_ID em teste)
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
